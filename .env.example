# Update these with your Supabase project's details (Project Settings > API)
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The canonical production URL of this app. Used for auth redirect links and
# page metadata. Set this in Vercel to your real domain (e.g. the value below)
# so auth emails/redirects never point at a stale preview URL.
NEXT_PUBLIC_SITE_URL=https://embrastic.vercel.app
